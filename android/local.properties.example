# Copy to local.properties and set your Android SDK path.
# This file is machine-specific and must NOT be committed.
sdk.dir=/Users/you/Library/Android/sdk

# Optionally override signaling/ICE configuration per machine. These take
# precedence over the defaults in gradle.properties.
# SIGNALING_URL=http://192.168.1.20:4000
# STUN_URLS=stun:stun.l.google.com:19302
# TURN_URL=turn:turn.example.com:3478
# TURN_USERNAME=user
# TURN_CREDENTIAL=pass
