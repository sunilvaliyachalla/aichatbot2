# URL of the Socket.IO signaling server.
# For LAN testing, use your machine's IP, e.g. http://192.168.1.20:4000
VITE_SIGNALING_URL=http://localhost:4000

# STUN servers (comma-separated). Public Google STUN is fine for development.
VITE_STUN_URLS=stun:stun.l.google.com:19302,stun:stun1.l.google.com:19302

# --- Optional TURN (needed when peers are on networks that block direct P2P) ---
# Leave blank to disable TURN. When set, all three are required.
VITE_TURN_URL=
VITE_TURN_USERNAME=
VITE_TURN_CREDENTIAL=

# --- Optional AI features (captions / summary / Q&A via the FastAPI ai-server) ---
# Blank  -> AI features hidden (default).
# proxy  -> use this web origin via the Vite AI proxy (best for HTTPS / phones).
# <url>  -> talk to the ai-server directly, e.g. http://localhost:8000 (http dev).
# Point the proxy target with AI_PROXY_TARGET when running `npm run dev`.
VITE_AI_SERVER_URL=
