# --- HTTP server ---
AI_HOST=0.0.0.0
AI_PORT=8000
# Comma-separated CORS origins ("*" for local dev).
AI_CORS_ORIGIN=*

# --- Speech-to-text (faster-whisper) ---
# Model size: tiny | base | small | medium | large-v3
WHISPER_MODEL=base
WHISPER_DEVICE=cpu
WHISPER_COMPUTE_TYPE=int8
# Language hint (e.g. "en"); leave blank to auto-detect.
ASR_LANGUAGE=

# --- LLM via Ollama (OpenAI-compatible API) ---
# Start Ollama locally and pull a model: `ollama pull llama3.1`
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
LLM_TIMEOUT_SECONDS=60
